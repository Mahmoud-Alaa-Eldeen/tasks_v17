<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ROP Product Tree View -->
        <record id="view_product_rop_tree" model="ir.ui.view">
            <field name="name">product.template.rop.tree</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <tree string="ROP Products (Qty &lt; 5)" default_order="rop_qty_available asc" create="false" edit="false">
                    <field name="name" string="Product Name"/>
                    <field name="default_code" string="Internal Reference"/>
                    <field name="categ_id" string="Category"/>
                    <field name="rop_qty_available" string="Available Qty"/>
                    <field name="uom_id" string="Unit of Measure"/>
                    <field name="list_price" string="Sales Price"/>
                    <field name="active" invisible="1"/>
                </tree>
            </field>
        </record>

