        <!-- ROP Product Form View (Read-only) -->
        <record id="view_product_rop_form" model="ir.ui.view">
            <field name="name">product.template.rop.form</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <form string="ROP Product Details" create="false" edit="false">
                    <sheet>
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                            <div>
                                <field name="default_code" readonly="1"/>
                            </div>
                        </div>
                        <group>
                            <group>
                                <field name="categ_id" readonly="1"/>
                                <field name="uom_id" readonly="1"/>
                                <field name="rop_qty_available" readonly="1"/>
                            </group>
                            <group>
                                <field name="list_price" readonly="1"/>
                                <field name="standard_price" readonly="1"/>
                                <field name="active" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <field name="type" readonly="1"/>
                                    <field name="sale_ok" readonly="1"/>
                                    <field name="purchase_ok" readonly="1"/>
                                </group>
                            </page>
                            <page string="Description">
                                <field name="description" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ROP Product Action -->
        <record id="action_product_rop" model="ir.actions.act_window">
            <field name="name">ROP Products</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_product_rop_tree"/>
            <!-- <field name="search_view_id" ref="view_product_rop_search"/> -->
            <field name="domain">[('type', '=', 'product'), ('active', '=', True), ('rop_qty_available', '&lt;', 5)]</field>
            <field name="context">{'search_default_low_stock': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No products found with low stock!
                </p>
                <p>
                    This view shows products with quantity less than 5 units.
                    Products are automatically filtered based on their available quantity.
                </p>
            </field>
        </record>

    </data>
</odoo>
